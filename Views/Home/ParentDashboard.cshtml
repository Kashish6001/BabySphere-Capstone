@model BabySphere.Models.ParentProfile

@{
    ViewData["Title"] = "Parent Dashboard";

    string displayName =
        ViewBag.UserName as string ?? "Parent";
}

<div class="container mt-4">

    <h1>Parent Dashboard</h1>

    <div class="alert alert-success">
        Welcome, @displayName!
    </div>

    <p>
        You are successfully logged in with the Parent role.
    </p>

    <div class="card p-4 shadow-sm mb-4">

        <h3>Parent Services</h3>

        <p>
            Use the options below to access BabySphere services.
        </p>

        <div class="d-flex gap-2 flex-wrap">

            <a asp-controller="Home"
               asp-action="ParentSupport"
               class="btn btn-primary">
                Submit Support Request
            </a>

            <a asp-controller="Home"
               asp-action="SupportHistory"
               class="btn btn-success">
                View Support History
            </a>

            <a asp-controller="Home"
               asp-action="Babysitters"
               class="btn btn-outline-primary">
                Browse Babysitters
            </a>

            <a asp-controller="Home"
               asp-action="Products"
               class="btn btn-outline-secondary">
                View Products
            </a>

        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model?.TicketNumber))
    {
        <div class="card p-4 shadow-sm mb-4">

            <h3>Support Request Submitted</h3>

            <p>
                <strong>Ticket Number:</strong>
                @Model.TicketNumber
            </p>

            <p>
                <strong>Status:</strong>
                @Model.Status
            </p>

            <p>
                <strong>Support Category:</strong>
                @Model.SupportCategory
            </p>

            <p>
                <strong>Recommendation:</strong>
                @Model.Recommendation
            </p>

        </div>
    }

    <a asp-controller="Admin"
       asp-action="Logout"
       class="btn btn-danger">
        Logout
    </a>

</div>