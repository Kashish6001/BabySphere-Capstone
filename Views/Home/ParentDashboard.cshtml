@model BabySphere.Models.ParentProfile

<h1>Parent Dashboard</h1>

<div class="card p-4 shadow-sm">
    <h3>Welcome, @Model.ParentName!</h3>

    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.PhoneNumber</p>
    <p><strong>Child Name:</strong> @Model.ChildName</p>
    <p><strong>Child Age:</strong> @Model.ChildAge</p>
    <p><strong>Care Needs:</strong> @Model.CareNeeds</p>

    <a asp-controller="Home" asp-action="Babysitters" class="btn btn-primary">
        Find Babysitters
    </a>
</div>