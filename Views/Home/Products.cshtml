@model List<BabySphere.Models.BabyProduct>

@{
    ViewData["Title"] = "Baby Products";

    var categories = Model
        .Where(p => !string.IsNullOrWhiteSpace(p.Category))
        .Select(p => p.Category)
        .Distinct()
        .OrderBy(category => category)
        .ToList();
}

<h1 class="text-center mb-3">Baby Products</h1>

<p class="text-center text-muted">
    Choose a category to explore baby care products.
</p>

<div class="row justify-content-center mb-4">
    <div class="col-md-6">
        <input type="text"
               id="searchInput"
               class="form-control"
               placeholder="🔍 Search baby products..." />
    </div>
</div>

<div class="text-center mb-4">
    <button type="button"
            class="btn btn-primary mx-1 mb-2 category-btn active-category"
            data-category="All">
        All
    </button>

    @foreach (var category in categories)
    {
        <button type="button"
                class="btn btn-outline-primary mx-1 mb-2 category-btn"
                data-category="@category">
            @category
        </button>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        No products are currently available.
    </div>
}
else
{
    <div id="noProductsMessage"
         class="alert alert-warning text-center"
         style="display:none;">
        No products match your search.
    </div>

    <div class="row" id="productGrid">
        @foreach (var product in Model)
        {
            string productCategory =
                product.Category?.ToLowerInvariant() ?? string.Empty;

            string productName =
                product.Name?.ToLowerInvariant() ?? string.Empty;

            string productDescription =
                product.Description?.ToLowerInvariant() ?? string.Empty;

            <div class="col-sm-6 col-md-4 col-lg-3 mb-4 product-card"
                 data-category="@productCategory"
                 data-name="@productName"
                 data-description="@productDescription">

                <div class="card h-100 shadow-sm">
                    <div class="card-img-container p-3">
                        <img src="@(string.IsNullOrWhiteSpace(product.ImageUrl)
                                                            ? "/images/product-placeholder.png"
                                                            : product.ImageUrl)"
                             class="card-img-top"
                             alt="@product.Name"
                             style="height:180px; object-fit:contain;" />
                    </div>

                    <div class="card-body text-center d-flex flex-column">
                        <h5>@product.Name</h5>

                        <p class="text-muted mb-2">
                            @product.Category
                        </p>

                        <p class="mb-2">
                            <strong>@product.Price.ToString("C")</strong>
                        </p>

                        <p class="mb-2">
                            ⭐ @product.Rating.ToString("0.0") / 5
                        </p>

                        @if (product.Quantity > 0)
                        {
                            <p class="text-success mb-3">
                                In stock: @product.Quantity
                            </p>
                        }
                        else
                        {
                            <p class="text-danger mb-3">
                                Out of stock
                            </p>
                        }

                        <a asp-controller="Home"
                           asp-action="ProductDetails"
                           asp-route-id="@product.Id"
                           class="btn btn-primary mt-auto">
                            View Product
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const buttons = document.querySelectorAll(".category-btn");
        const products = document.querySelectorAll(".product-card");
        const searchInput = document.getElementById("searchInput");
        const noProductsMessage =
            document.getElementById("noProductsMessage");

        let selectedCategory = "All";

        function filterProducts() {
            const searchText =
                searchInput.value.trim().toLowerCase();

            let visibleProducts = 0;

            products.forEach(product => {
                const category = product.dataset.category || "";
                const name = product.dataset.name || "";
                const description =
                    product.dataset.description || "";

                const matchesCategory =
                    selectedCategory === "All" ||
                    category === selectedCategory.toLowerCase();

                const matchesSearch =
                    name.includes(searchText) ||
                    category.includes(searchText) ||
                    description.includes(searchText);

                const shouldDisplay =
                    matchesCategory && matchesSearch;

                product.style.display =
                    shouldDisplay ? "" : "none";

                if (shouldDisplay) {
                    visibleProducts++;
                }
            });

            if (noProductsMessage) {
                noProductsMessage.style.display =
                    visibleProducts === 0 ? "block" : "none";
            }
        }

        buttons.forEach(button => {
            button.addEventListener("click", function() {
                selectedCategory = button.dataset.category;

                buttons.forEach(item => {
                    item.classList.remove(
                        "btn-primary",
                        "active-category"
                    );

                    item.classList.add(
                        "btn-outline-primary"
                    );
                });

                button.classList.remove(
                    "btn-outline-primary"
                );

                button.classList.add(
                    "btn-primary",
                    "active-category"
                );

                filterProducts();
            });
        });

        searchInput.addEventListener(
            "input",
            filterProducts
        );
    });
</script>











