@{
    ViewData["Title"] = "Child Health";
}

<h1>Child Health</h1>
<p>Support healthy growth and child wellness with simple care guidance.</p>

<div class="row">

    <div class="col-md-4 mb-3">
        <div class="card p-3 shadow-sm">
            <h4>Sleep Routine</h4>
            <p>Create a consistent sleep schedule to support healthy development.</p>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card p-3 shadow-sm">
            <h4>Feeding Support</h4>
            <p>Track feeding needs and maintain healthy daily routines.</p>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card p-3 shadow-sm">
            <h4>Safety Tips</h4>
            <p>Keep emergency contacts and care instructions ready for babysitters.</p>
        </div>
    </div>

</div>

<a asp-controller="Home" asp-action="ParentSupport" class="btn btn-primary">
    Create Parent Profile
</a>