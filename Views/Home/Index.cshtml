@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center hero-row">

            <div class="col-lg-6">
                <div class="hero-badge">
                    <span class="badge-dot"></span>
                    Trusted support for modern families
                </div>

                <h1 class="hero-title">
                    Helping families care
                    <span>with confidence.</span>
                </h1>

                <p class="hero-description">
                    Find trusted babysitters, discover baby essentials,
                    access parenting support, and keep track of your
                    child's wellness — all in one place.
                </p>

                <div class="hero-buttons">
                    <a asp-controller="Home"
                       asp-action="Babysitters"
                       class="btn-primary-custom">

                        Find a Babysitter
                        <span>→</span>
                    </a>

                    <a asp-controller="Home"
                       asp-action="ParentSupport"
                       class="btn-secondary-custom">

                        Parent Support
                    </a>
                </div>

                <div class="hero-trust">

                    <div class="trust-item">
                        <div class="trust-icon">✓</div>
                        <div>
                            <strong>Trusted Profiles</strong>
                            <span>Browse experienced caregivers</span>
                        </div>
                    </div>

                    <div class="trust-item">
                        <div class="trust-icon">✓</div>
                        <div>
                            <strong>Simple Booking</strong>
                            <span>Request care in minutes</span>
                        </div>
                    </div>

                </div>
            </div>


            <div class="col-lg-6">
                <div class="hero-visual">

                    <div class="hero-image-wrapper">
                        <img src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=1200&q=85"
                             alt="Parent caring for baby"
                             class="hero-image" />
                    </div>

                    <div class="floating-card floating-card-top">
                        <div class="floating-icon">♥</div>

                        <div>
                            <strong>Parent-first care</strong>
                            <span>Support when you need it</span>
                        </div>
                    </div>

                    <div class="floating-card floating-card-bottom">
                        <div class="rating-number">4.9</div>

                        <div>
                            <div class="stars">★★★★★</div>
                            <span>Trusted family experience</span>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>


<section class="quick-stats">
    <div class="container">
        <div class="stats-container">

            <div class="stat-item">
                <strong>Care</strong>
                <span>Babysitter discovery</span>
            </div>

            <div class="stat-divider"></div>

            <div class="stat-item">
                <strong>Support</strong>
                <span>Parent resources</span>
            </div>

            <div class="stat-divider"></div>

            <div class="stat-item">
                <strong>Wellness</strong>
                <span>Child health guidance</span>
            </div>

            <div class="stat-divider"></div>

            <div class="stat-item">
                <strong>Essentials</strong>
                <span>Baby products</span>
            </div>

        </div>
    </div>
</section>


<section class="services-section">

    <div class="container">

        <div class="section-heading">
            <span class="section-label">BABYSPHERE SERVICES</span>

            <h2>Everything your family needs</h2>

            <p>
                BabySphere brings essential childcare resources together
                so parents can spend less time searching and more time caring.
            </p>
        </div>


        <div class="row g-4">

            <div class="col-md-6 col-lg-3">
                <a asp-controller="Home"
                   asp-action="Babysitters"
                   class="service-card">

                    <div class="service-icon sitter-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <circle cx="12" cy="8" r="4"></circle>

                            <path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path>

                        </svg>

                    </div>

                    <h3>Find Babysitters</h3>

                    <p>
                        Browse caregiver profiles by experience,
                        rating and hourly rate.
                    </p>

                    <span class="card-link">
                        Browse babysitters →
                    </span>

                </a>
            </div>


            <div class="col-md-6 col-lg-3">
                <a asp-controller="Home"
                   asp-action="Products"
                   class="service-card">

                    <div class="service-icon product-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <path d="M6 8h12l-1 12H7L6 8Z"></path>
                            <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>

                        </svg>

                    </div>

                    <h3>Baby Products</h3>

                    <p>
                        Discover useful baby essentials for
                        everyday family life.
                    </p>

                    <span class="card-link">
                        Explore products →
                    </span>

                </a>
            </div>


            <div class="col-md-6 col-lg-3">
                <a asp-controller="Home"
                   asp-action="ParentSupport"
                   class="service-card">

                    <div class="service-icon support-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <path d="M21 15a4 4 0 0 1-4 4H9l-5 3v-7a7 7 0 1 1 17 0Z"></path>

                        </svg>

                    </div>

                    <h3>Parent Support</h3>

                    <p>
                        Get guidance for feeding, sleep,
                        childcare and everyday parenting.
                    </p>

                    <span class="card-link">
                        Get support →
                    </span>

                </a>
            </div>


            <div class="col-md-6 col-lg-3">
                <a asp-controller="Home"
                   asp-action="ChildHealth"
                   class="service-card">

                    <div class="service-icon wellness-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <path d="M12 21s-8-5.2-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 5.8-8 11-8 11Z"></path>

                        </svg>

                    </div>

                    <h3>Child Wellness</h3>

                    <p>
                        Access helpful wellness information
                        for your growing child.
                    </p>

                    <span class="card-link">
                        View wellness →
                    </span>

                </a>
            </div>

        </div>

    </div>
</section>


<section class="how-section">

    <div class="container">

        <div class="section-heading">
            <span class="section-label">HOW IT WORKS</span>
            <h2>Support in three simple steps</h2>
        </div>


        <div class="row g-4">

            <div class="col-md-4">
                <div class="step-card">

                    <div class="step-number">01</div>

                    <h3>Explore</h3>

                    <p>
                        Browse babysitters, parenting resources,
                        baby products and wellness information.
                    </p>

                </div>
            </div>


            <div class="col-md-4">
                <div class="step-card">

                    <div class="step-number">02</div>

                    <h3>Choose</h3>

                    <p>
                        Compare options and select the support
                        that best fits your family's needs.
                    </p>

                </div>
            </div>


            <div class="col-md-4">
                <div class="step-card">

                    <div class="step-number">03</div>

                    <h3>Get Support</h3>

                    <p>
                        Book care, submit a support request,
                        or access helpful family resources.
                    </p>

                </div>
            </div>

        </div>

    </div>
</section>


<section class="feature-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="feature-photo">
                    <img src="https://images.unsplash.com/photo-1492725764893-90b379c2b6e7?auto=format&fit=crop&w=1200&q=85"
                         alt="Family with child" />

                    <div class="feature-photo-card">
                        <span>♥</span>

                        <div>
                            <strong>Made for families</strong>
                            <small>Simple. Helpful. Reliable.</small>
                        </div>
                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <span class="section-label">
                    WHY BABYSPHERE
                </span>

                <h2 class="feature-heading">
                    Less searching.
                    <br />
                    More time for what matters.
                </h2>

                <p class="feature-description">
                    Parenting already comes with enough decisions.
                    BabySphere organizes important family resources into
                    one simple platform designed around everyday needs.
                </p>


                <div class="benefit-item">

                    <div class="benefit-check">✓</div>

                    <div>
                        <strong>Simple and easy to use</strong>

                        <p>
                            Find the information you need without
                            complicated navigation.
                        </p>
                    </div>

                </div>


                <div class="benefit-item">

                    <div class="benefit-check">✓</div>

                    <div>
                        <strong>Family-focused services</strong>

                        <p>
                            Babysitting, wellness, products and
                            parenting support in one platform.
                        </p>
                    </div>

                </div>


                <div class="benefit-item">

                    <div class="benefit-check">✓</div>

                    <div>
                        <strong>Built for everyday parenting</strong>

                        <p>
                            Useful tools designed around real
                            family situations.
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </div>
</section>


