</section>


<section class="final-cta">

    <div class="container">

        <div class="cta-box">

            <div>
                <span class="cta-small">
                    START WITH BABYSPHERE
                </span>

                <h2>
                    Family support should feel simple.
                </h2>

                <p>
                    Explore trusted childcare resources created
                    to support parents every day.
                </p>
            </div>

            <div class="cta-buttons">

                <a asp-controller="Home"
                   asp-action="Babysitters"
                   class="cta-white-btn">

                    Find Babysitters
                </a>

                <a asp-controller="Home"
                   asp-action="ParentSupport"
                   class="cta-outline-btn">

                    Get Support
                </a>

            </div>

        </div>

    </div>

</section>