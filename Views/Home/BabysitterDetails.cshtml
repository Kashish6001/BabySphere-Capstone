@model BabySphere.Models.Babysitter

@{
    ViewData["Title"] = "Babysitter Details";
}

<h1>Babysitter Profile</h1>

<div class="card p-4 shadow-sm">

    <h3>@Model.Name</h3>

    <p>Experience: @Model.Experience years</p>

    <p>Skills: @Model.Skills</p>

    <p>Rating: ⭐@Model.Rating</p>

    <p>Rate: $@Model.HourlyRate/hour</p>

    <a href="/Home/Booking?name=@Model.Name"
       class="btn btn-success">
        Book Now
    </a>

</div>