@model List<BabySphere.Models.Babysitter>

@{
    ViewData["Title"] = "Babysitters";
}

<h1>Babysitters</h1>
<p>Find trusted babysitters and childcare services.</p>

<div class="row mt-4">

    @foreach (var babysitter in Model)
    {
        <div class="col-md-4 mb-3">

            <div class="card p-3 shadow-sm">

                <h4>@babysitter.Name</h4>

                <p>Experience: @babysitter.Experience years</p>

                <p>Rating: ⭐@babysitter.Rating</p>

                <p>$@babysitter.HourlyRate/hour</p>

                <a class="btn btn-primary"
                   href="/Home/BabysitterDetails/@babysitter.Id">
                    View Profile
                </a>

            </div>

        </div>
    }

</div>