@model List<BabySphere.Models.ParentProfile>

<h1>Parent Support History</h1>
<p>View submitted parent support requests.</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No support requests have been submitted yet.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Ticket Number</th>
                <th>Parent Name</th>
                <th>Email</th>
                <th>Child Name</th>
                <th>Support Category</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.TicketNumber</td>
                    <td>@request.ParentName</td>
                    <td>@request.Email</td>
                    <td>@request.ChildName</td>
                    <td>@request.SupportCategory</td>
                    <td>@request.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Home" asp-action="ParentSupport" class="btn btn-primary">
    Submit New Request
</a>