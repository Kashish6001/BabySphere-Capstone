@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">

    <!-- ==========================================
         HERO
    =========================================== -->

    <section class="privacy-hero">

        <div class="container">

            <div class="privacy-hero-layout">

                <div class="privacy-hero-content">

                    <div class="privacy-eyebrow">

                        <span class="privacy-eyebrow-dot"></span>

                        YOUR PRIVACY MATTERS

                    </div>


                    <h1>
                        Privacy made
                        <span>clear and simple.</span>
                    </h1>


                    <p>
                        BabySphere is designed to support families while
                        keeping account and service information handled
                        responsibly. This page explains the types of
                        information used within the platform and how
                        that information supports BabySphere services.
                    </p>


                    <div class="privacy-updated">

                        <div class="privacy-updated-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.7">

                                <circle cx="12"
                                        cy="12"
                                        r="9">
                                </circle>

                                <path d="M12 7v5l3 2"></path>

                            </svg>

                        </div>

                        <div>

                            <span>
                                LAST UPDATED
                            </span>

                            <strong>
                                August 2026
                            </strong>

                        </div>

                    </div>

                </div>


                <div class="privacy-hero-card">

                    <div class="privacy-lock-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.6">

                            <rect x="5"
                                  y="10"
                                  width="14"
                                  height="10"
                                  rx="2">
                            </rect>

                            <path d="M8 10V7a4 4 0 0 1 8 0v3">
                            </path>

                        </svg>

                    </div>


                    <span class="privacy-card-label">
                        BABYSPHERE PRIVACY
                    </span>


                    <h3>
                        Information with purpose
                    </h3>


                    <p>
                        Information entered into BabySphere is used
                        to support platform features such as account
                        access, bookings, parent support and product browsing.
                    </p>


                    <div class="privacy-card-points">

                        <div>
                            <span>✓</span>
                            Account information
                        </div>

                        <div>
                            <span>✓</span>
                            Booking information
                        </div>

                        <div>
                            <span>✓</span>
                            Parent support requests
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================
         QUICK SUMMARY
    =========================================== -->

    <section class="privacy-summary-section">

        <div class="container">

            <div class="privacy-section-heading">

                <span class="privacy-section-label">
                    PRIVACY AT A GLANCE
                </span>

                <h2>
                    How BabySphere handles information
                </h2>

                <p>
                    Here are the main privacy principles behind
                    the BabySphere platform.
                </p>

            </div>


            <div class="row g-4">

                <div class="col-md-4">

                    <div class="privacy-summary-card">

                        <div class="privacy-summary-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.7">

                                <path d="M4 4h16v16H4z"></path>

                                <path d="M8 9h8"></path>

                                <path d="M8 13h5"></path>

                            </svg>

                        </div>

                        <span class="privacy-summary-number">
                            01
                        </span>

                        <h3>
                            Relevant Information
                        </h3>

                        <p>
                            BabySphere uses information that is
                            relevant to providing its platform features.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="privacy-summary-card">

                        <div class="privacy-summary-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.7">

                                <path d="M12 3 20 7v5c0 5-3.4 8-8 9-4.6-1-8-4-8-9V7l8-4Z">
                                </path>

                                <path d="m9 12 2 2 4-4">
                                </path>

                            </svg>

                        </div>

                        <span class="privacy-summary-number">
                            02
                        </span>

                        <h3>
                            Service Protection
                        </h3>

                        <p>
                            Account and session information helps keep
                            platform features available to the correct users.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="privacy-summary-card">

                        <div class="privacy-summary-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.7">

                                <path d="M4 4h16v13H8l-4 3V4Z"></path>

                            </svg>

                        </div>

                        <span class="privacy-summary-number">
                            03
                        </span>

                        <h3>
                            Clear Communication
                        </h3>

                        <p>
                            BabySphere aims to explain how information
                            is used in straightforward language.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================
         POLICY CONTENT
    =========================================== -->

    <section class="privacy-policy-section">

        <div class="container">

            <div class="privacy-policy-layout">


                <!-- SIDE NAVIGATION -->

                <aside class="privacy-side-card">

                    <span class="privacy-side-label">
                        ON THIS PAGE
                    </span>

                    <a href="#information">
                        Information We Use
                    </a>

                    <a href="#usage">
                        How Information Is Used
                    </a>

                    <a href="#accounts">
                        Accounts and Sessions
                    </a>

                    <a href="#support">
                        Support Requests
                    </a>

                    <a href="#cookies">
                        Cookies and Browser Data
                    </a>

                    <a href="#children">
                        Children's Information
                    </a>

                    <a href="#security">
                        Data Protection
                    </a>

                    <a href="#changes">
                        Policy Updates
                    </a>

                    <a href="#privacyContact">
                        Contact Us
                    </a>

                </aside>


                <!-- MAIN POLICY -->

                <div class="privacy-policy-content">


                    <article class="privacy-policy-block"
                             id="information">

                        <div class="privacy-policy-number">
                            01
                        </div>

                        <div>

                            <h2>
                                Information We Use
                            </h2>

                            <p>
                                BabySphere may use information entered
                                through the platform when users interact
                                with account, booking, support and product features.
                            </p>

                            <p>
                                Depending on the feature being used,
                                this may include information such as a user's
                                name, email address, account role, booking details
                                or information submitted through Parent Support.
                            </p>

                        </div>

                    </article>


                    <article class="privacy-policy-block"
                             id="usage">

                        <div class="privacy-policy-number">
                            02
                        </div>

                        <div>

                            <h2>
                                How Information Is Used
                            </h2>

                            <p>
                                Information may be used to provide and
                                organize BabySphere services. For example,
                                the platform may use information to:
                            </p>

                            <ul class="privacy-list">

                                <li>
                                    Sign users into the appropriate account dashboard.
                                </li>

                                <li>
                                    Process and display babysitter booking information.
                                </li>

                                <li>
                                    Create Parent Support tickets and recommendations.
                                </li>

                                <li>
                                    Display product and availability information.
                                </li>

                                <li>
                                    Improve the organization and usability of the platform.
                                </li>

                            </ul>

                        </div>

                    </article>


                    <article class="privacy-policy-block"
                             id="accounts">

                        <div class="privacy-policy-number">
                            03
                        </div>

                        <div>

                            <h2>
                                Accounts and Sessions
                            </h2>

                            <p>
                                BabySphere uses account information to identify
                                whether a signed-in user is an Admin, Parent or
                                Babysitter and to open the appropriate dashboard.
                            </p>

                            <p>
                                Session information may be used temporarily
                                while a user is signed in to maintain access
                                to the correct BabySphere features.
                            </p>

                        </div>

                    </article>


                    <article class="privacy-policy-block"
                             id="support">

                        <div class="privacy-policy-number">
                            04
                        </div>

                        <div>

                            <h2>
                                Parent Support Requests
                            </h2>

                            <p>
                                When Parent Support is used, submitted
                                information may be stored so BabySphere can
                                generate a ticket number, status and recommended
                                next step.
                            </p>

                            <div class="privacy-note">

                                <div>
                                    !
                                </div>

                                <p>
                                    Users should avoid entering unnecessary
                                    sensitive personal or medical information
                                    into general support forms.
                                </p>

                            </div>

                        </div>

                    </article>


                    <article class="privacy-policy-block"
                             id="cookies">

                        <div class="privacy-policy-number">
                            05
                        </div>

                        <div>

                            <h2>
                                Cookies and Browser Data
                            </h2>

                            <p>
                                The application may rely on standard browser
                                and session technologies required for website
                                functionality, authentication and navigation.
                            </p>

                            <p>
                                These technologies help the application remember
                                information during an active session and support
                                normal website functionality.
                            </p>

                        </div>

                    </article>


                    <article class="privacy-policy-block"
                             id="children">

                        <div class="privacy-policy-number">
                            06
                        </div>

                        <div>

                            <h2>
                                Children's Information
                            </h2>

                            <p>
                                BabySphere is designed as a family support
                                platform. Parents and caregivers should only
                                provide information that is necessary for the
                                feature they are using.
                            </p>

                            <p>
                                Users should avoid entering highly sensitive
                                information about children unless it is necessary
                                for the intended service.
                            </p>

                        </div>

                    </article>


                    <article class="privacy-policy-block"
                             id="security">

                        <div class="privacy-policy-number">
                            07
                        </div>

                        <div>

                            <h2>
                                Protecting Information
                            </h2>

                            <p>
                                BabySphere is designed to separate account roles
                                and provide users with access to features that
                                correspond to their assigned role.
                            </p>

                            <p>
                                No website or software system can guarantee
                                absolute security. Users should protect their
                                login information and avoid sharing account
                                credentials with other people.
                            </p>

                        </div>

                    </article>


                    <article class="privacy-policy-block"
                             id="changes">

                        <div class="privacy-policy-number">
                            08
                        </div>

                        <div>

                            <h2>
                                Updates to This Policy
                            </h2>

                            <p>
                                This Privacy Policy may be updated as
                                BabySphere features change or new platform
                                functionality is introduced.
                            </p>

                            <p>
                                When significant updates are made,
                                the date shown at the top of this page
                                may also be updated.
                            </p>

                        </div>

                    </article>


                    <article class="privacy-policy-block"
                             id="privacyContact">

                        <div class="privacy-policy-number">
                            09
                        </div>

                        <div>

                            <h2>
                                Questions About Privacy
                            </h2>

                            <p>
                                If you have questions about BabySphere
                                or how the platform handles information,
                                you can contact us through the Contact page.
                            </p>


                            <a asp-controller="Home"
                               asp-action="Contact"
                               class="privacy-contact-button">

                                Contact BabySphere

                                <span>→</span>

                            </a>

                        </div>

                    </article>


                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================
         FINAL CTA
    =========================================== -->

    <section class="privacy-cta-section">

        <div class="container">

            <div class="privacy-cta">

                <div class="privacy-cta-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.6">

                        <rect x="5"
                              y="10"
                              width="14"
                              height="10"
                              rx="2">
                        </rect>

                        <path d="M8 10V7a4 4 0 0 1 8 0v3">
                        </path>

                    </svg>

                </div>


                <div>

                    <span>
                        BABYSPHERE
                    </span>

                    <h2>
                        Family support with privacy in mind.
                    </h2>

                    <p>
                        Continue exploring BabySphere's childcare,
                        wellness and family support resources.
                    </p>

                </div>


                <a asp-controller="Home"
                   asp-action="Index"
                   class="privacy-cta-button">

                    Back to Home

                    <span>→</span>

                </a>

            </div>

        </div>

    </section>

</div>