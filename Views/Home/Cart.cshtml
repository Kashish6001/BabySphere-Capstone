@model List<BabySphere.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    decimal total = Model.Sum(x => x.Subtotal);
}

<div class="container py-5">

    <h1>Your Cart</h1>

    <p class="text-muted">
        Review the baby products you selected.
    </p>

    <a asp-controller="Home"
       asp-action="Products"
       class="btn btn-outline-secondary mb-4">

        ← Continue Shopping

    </a>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">

            <h3>Your cart is empty</h3>

            <p>
                You haven't added any products yet.
            </p>

            <a asp-controller="Home"
               asp-action="Products"
               class="btn btn-success">

                Browse Baby Products

            </a>

        </div>
    }
    else
    {
        <div class="row mt-4">

            <div class="col-lg-8">

                @foreach (var item in Model)
                {
                    <div class="card mb-3">

                        <div class="card-body">

                            <div class="row align-items-center">

                                <div class="col-md-2">

                                    <img src="@item.ImageUrl"
                                         alt="@item.Name"
                                         class="img-fluid rounded" />

                                </div>

                                <div class="col-md-4">

                                    <h5>
                                        @item.Name
                                    </h5>

                                    <span>
                                        $@item.Price.ToString("0.00")
                                    </span>

                                </div>

                                <div class="col-md-2">

                                    <div class="d-flex align-items-center gap-2">

                                        <form asp-controller="Home"
                                              asp-action="DecreaseCartQuantity"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.ProductId" />

                                            <button type="submit"
                                                    class="btn btn-outline-secondary btn-sm">

                                                −

                                            </button>

                                        </form>


                                        <strong>
                                            @item.Quantity
                                        </strong>


                                        <form asp-controller="Home"
                                              asp-action="IncreaseCartQuantity"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.ProductId" />

                                            <button type="submit"
                                                    class="btn btn-outline-secondary btn-sm">

                                                +

                                            </button>

                                        </form>

                                    </div>

                                </div>

                                <div class="col-md-2">

                                    <strong>
                                        $@item.Subtotal.ToString("0.00")
                                    </strong>

                                </div>

                                <div class="col-md-2">

                                    <form asp-controller="Home"
                                          asp-action="RemoveFromCart"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.ProductId" />

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">

                                            Remove

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

            <div class="col-lg-4">

                <div class="card">

                    <div class="card-body">

                        <h4>Cart Summary</h4>

                        <hr />

                        <p>
                            Items:
                            <strong>
                                @Model.Sum(x => x.Quantity)
                            </strong>
                        </p>

                        <p>
                            Total:
                            <strong>
                                $@total.ToString("0.00")
                            </strong>
                        </p>

                    </div>

                </div>

            </div>

        </div>
    }

</div>
