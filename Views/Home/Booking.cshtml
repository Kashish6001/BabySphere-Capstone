@{
    ViewData["Title"] = "Booking";
}

<h1>Book Babysitter</h1>

<div class="alert alert-info">
    Booking for: <strong>@ViewBag.BabysitterName</strong>
</div>

<form asp-action="ConfirmBooking" method="post">

    <input type="hidden" name="babysitterName" value="@ViewBag.BabysitterName" />

    <div class="card p-4 shadow-sm">

        <label>Date</label>
        <input type="date" name="date" class="form-control mb-3" />

        <label>Time</label>
        <input type="time" class="form-control mb-3" />

        <label>Your Name</label>
        <input type="text"
               name="parentName"
               class="form-control mb-3"
               placeholder="Enter your name" />

        <button type="submit" class="btn btn-primary w-100">
            Confirm Booking
        </button>

    </div>

</form>