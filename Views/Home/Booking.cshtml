@model BabySphere.Models.Booking

@{
    ViewData["Title"] = "Book Babysitter";
}

<div class="container mt-4">

    <h1>Book Babysitter</h1>

    <div class="alert alert-info">
        Booking for:
        <strong>@Model.BabysitterName</strong>
    </div>

    <form asp-controller="Home"
          asp-action="ConfirmBooking"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <input asp-for="BabysitterName"
               type="hidden" />

        <div class="card p-4 shadow-sm">

            <div class="mb-3">
                <label asp-for="ParentName"
                       class="form-label">
                    Your Name
                </label>

                <input asp-for="ParentName"
                       class="form-control"
                       placeholder="Enter your name" />

                <span asp-validation-for="ParentName"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="BookingDate"
                       class="form-label">
                    Booking Date
                </label>

                <input asp-for="BookingDate"
                       type="date"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       class="form-control" />

                <span asp-validation-for="BookingDate"
                      class="text-danger">
                </span>
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="StartTime"
                           class="form-label">
                        Start Time
                    </label>

                    <input asp-for="StartTime"
                           type="time"
                           class="form-control" />

                    <span asp-validation-for="StartTime"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="EndTime"
                           class="form-label">
                        End Time
                    </label>

                    <input asp-for="EndTime"
                           type="time"
                           class="form-control" />

                    <span asp-validation-for="EndTime"
                          class="text-danger">
                    </span>
                </div>

            </div>

            <div class="mb-3">
                <label asp-for="Notes"
                       class="form-label">
                    Notes
                </label>

                <textarea asp-for="Notes"
                          class="form-control"
                          rows="3"
                          placeholder="Enter childcare instructions or notes"></textarea>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100">
                Confirm Booking
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}