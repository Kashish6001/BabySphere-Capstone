@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <h1>My Profile</h1>

    <div class="card shadow-sm p-4">

        <div class="alert alert-info">
            Logged in as @ViewBag.UserName
        </div>

        <h3>Babysitter Information</h3>

        <div class="row mt-3">

            <div class="col-md-6 mb-3">
                <label class="form-label">
                    Full Name
                </label>

                <input type="text"
                       class="form-control"
                       value="@ViewBag.UserName"
                       readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">
                    Account Role
                </label>

                <input type="text"
                       class="form-control"
                       value="Babysitter"
                       readonly />
            </div>

        </div>

        <p class="text-muted">
            Additional profile information can be connected to the
            database later.
        </p>

        <a asp-controller="Home"
           asp-action="BabysitterDashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

</div>