@model BabySphere.Models.Booking

@{
    ViewData["Title"] = "Booking Confirmed";
}

<h1 class="text-success">Booking Confirmed 🎉</h1>

<div class="card p-4 shadow-sm">
    <h4>Thank you, @Model.ParentName!</h4>

    <p>
        Your booking with
        <strong>@Model.BabysitterName</strong>
        has been securely saved to our database system.
    </p>

    <p>
        Date: <strong>@Model.Date.ToShortDateString()</strong> | Time: <strong>@Model.Time</strong>
    </p>

    <a href="/Home/Babysitters" class="btn btn-primary">
        Back to Babysitters
    </a>
</div>