@model BabySphere.Models.Booking

@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="container mt-4">

    <div class="alert alert-success">
        <h2>Booking Submitted 🎉</h2>

        <p class="mb-0">
            Your booking request was saved successfully.
        </p>
    </div>

    <div class="card p-4 shadow-sm">

        <p>
            <strong>Booking ID:</strong>
            @Model.Id
        </p>

        <p>
            <strong>Parent:</strong>
            @Model.ParentName
        </p>

        <p>
            <strong>Babysitter:</strong>
            @Model.BabysitterName
        </p>

        <p>
            <strong>Date:</strong>
            @Model.BookingDate.ToString("MMMM dd, yyyy")
        </p>

        <p>
            <strong>Time:</strong>
            @Model.StartTime.ToString(@"hh\:mm")
            -
            @Model.EndTime.ToString(@"hh\:mm")
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p>
                <strong>Notes:</strong>
                @Model.Notes
            </p>
        }

        <p>
            <strong>Status:</strong>

            <span class="badge bg-warning text-dark">
                @Model.Status
            </span>
        </p>

        <a asp-controller="Home"
           asp-action="Babysitters"
           class="btn btn-primary">
            Back to Babysitters
        </a>

    </div>

</div>