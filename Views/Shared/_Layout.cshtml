<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BabySphere</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>

<header class="main-header">

    <nav class="navbar navbar-expand-lg">

        <div class="container">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <span class="brand-symbol">
                    B
                </span>

                <span>
                    Baby<span>Sphere</span>
                </span>

            </a>


            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Home
                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Babysitters">

                            Babysitters
                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Products">

                            Products
                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="ParentSupport">

                            Parent Support
                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="ChildHealth">

                            Child Wellness
                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Contact">

                            Contact
                        </a>
                    </li>

                </ul>


                <div class="nav-actions">

                    <a asp-controller="Admin"
                       asp-action="Login"
                       class="nav-login">

                        Log in
                    </a>

                    <a asp-controller="Home"
                       asp-action="Babysitters"
                       class="nav-get-started">

                        Get Started
                    </a>

                </div>

            </div>

        </div>

    </nav>

</header>


<main>

    @RenderBody()

</main>


<footer class="site-footer">

    <div class="container">

        <div class="row g-5">

            <div class="col-lg-4">

                <a class="footer-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-symbol">
                        B
                    </span>

                    Baby<span>Sphere</span>

                </a>

                <p class="footer-description">
                    Helping parents find childcare resources,
                    family support and baby essentials in one
                    simple platform.
                </p>

            </div>


            <div class="col-6 col-lg-2">

                <h5>Explore</h5>

                <a asp-controller="Home"
                   asp-action="Babysitters">
                    Babysitters
                </a>

                <a asp-controller="Home"
                   asp-action="Products">
                    Baby Products
                </a>

                <a asp-controller="Home"
                   asp-action="ChildHealth">
                    Child Wellness
                </a>

            </div>


            <div class="col-6 col-lg-2">

                <h5>Support</h5>

                <a asp-controller="Home"
                   asp-action="ParentSupport">
                    Parent Support
                </a>

                <a asp-controller="Home"
                   asp-action="Contact">
                    Contact
                </a>

                <a asp-controller="Home"
                   asp-action="Privacy">
                    Privacy
                </a>

            </div>


            <div class="col-lg-4">

                <h5>BabySphere</h5>

                <p class="footer-small">
                    Support for modern parents,
                    whenever they need it.
                </p>

                <a asp-controller="Admin"
                   asp-action="Login"
                   class="footer-login">

                    Account Login →
                </a>

            </div>

        </div>


        <div class="footer-bottom">

            <span>
                © 2026 BabySphere. All rights reserved.
            </span>

            <span>
                Made for families.
            </span>

        </div>

    </div>

</footer>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync(
    "Scripts",
    required: false
)

</body>

</html>