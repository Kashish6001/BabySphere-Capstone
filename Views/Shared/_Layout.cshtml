@using Microsoft.AspNetCore.Http

@{
    string? userRole = Context.Session.GetString("UserRole");
    string? userName = Context.Session.GetString("UserName");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BabySphere</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/BabySphere.styles.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    BabySphere
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (userRole != "Babysitter")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Home"
                                   asp-action="Babysitters">
                                    Babysitters
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Home"
                               asp-action="Products">
                                Products
                            </a>
                        </li>

                        @if (userRole != "Babysitter")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Home"
                                   asp-action="ParentSupport">
                                    Parent Support
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Home"
                               asp-action="ChildHealth">
                                Child Wellness
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Home"
                               asp-action="Contact">
                                Contact
                            </a>
                        </li>

                        @if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold"
                                   asp-controller="Admin"
                                   asp-action="Dashboard">
                                    Admin Dashboard
                                </a>
                            </li>
                        }

                        @if (userRole == "Parent")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold"
                                   asp-controller="Home"
                                   asp-action="ParentDashboard">
                                    Parent Dashboard
                                </a>
                            </li>
                        }

                        @if (userRole == "Babysitter")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold"
                                   asp-controller="Home"
                                   asp-action="BabysitterDashboard">
                                    Babysitter Dashboard
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        @if (!string.IsNullOrEmpty(userRole))
                        {
                            <li class="nav-item me-lg-3 mb-2 mb-lg-0">
                                <span class="navbar-text text-white">
                                    Welcome, @userName
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-danger px-3"
                                   asp-controller="Admin"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-light text-primary px-3"
                                   asp-controller="Admin"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer text-muted">
        <div class="container text-center">
            &copy; 2026 BabySphere
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>