@using Microsoft.AspNetCore.Http

@{
    string? userRole = Context.Session.GetString("UserRole");
    string? userName = Context.Session.GetString("UserName");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BabySphere</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/BabySphere.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    BabySphere
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @* Hide this link from babysitters *@
                        @if (userRole != "Babysitter")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Home"
                                   asp-action="Babysitters">
                                    Babysitters
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Home"
                               asp-action="Products">
                                Products
                            </a>
                        </li>

                        @* Parent Support is not needed for a babysitter *@
                        @if (userRole != "Babysitter")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Home"
                                   asp-action="ParentSupport">
                                    Parent Support
                                </a>
                            </li>
                        }

                        @if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold text-decoration-underline"
                                   asp-controller="Admin"
                                   asp-action="Dashboard">
                                    Admin Dashboard
                                </a>
                            </li>
                        }

                        @if (userRole == "Parent")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold"
                                   asp-controller="Home"
                                   asp-action="ParentDashboard">
                                    Parent Dashboard
                                </a>
                            </li>
                        }

                        @if (userRole == "Babysitter")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold"
                                   asp-controller="Home"
                                   asp-action="BabysitterDashboard">
                                    Babysitter Dashboard
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Home"
                               asp-action="Contact">
                                Contact
                            </a>
                        </li>

                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">

                        @if (userRole != null)
                        {
                            <li class="nav-item me-3">
                                <span class="navbar-text text-white">
                                    Welcome, @userName
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-danger text-white px-3"
                                   asp-controller="Admin"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-light text-primary px-3"
                                   asp-controller="Admin"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BabySphere
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>